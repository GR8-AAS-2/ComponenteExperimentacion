# Configuración de base de datos PostgreSQL
DATABASE_URL=postgresql://postgres.********:********.*******@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Configuración JWT
JWT_SECRET_KEY_MOTORPOLIZAS=secretkeymotorpolizas
JWT_SECRET_KEY_RESPUESTAINCIDENTES=secretkeyrespuestaincidentes
JWT_ALGORITHM=HS256

# API Keys
RESPUESTAINCIDENTES_API_KEY=apikeyrespuestaincidentes

# Rutas
MOTORPOLIZAS_URL=urlmotorpolizas
RESPUESTAINCIDENTES_URL=urlrespuestaincidentes

# Configuración de Flask
PORT=5000
DEBUG=True
